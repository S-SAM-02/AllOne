# ALL ONE local-first configuration
# Copy to server/.env. Never commit the real server/.env file.

# Local AI (free inference on your own computer)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# Cloud fallbacks are OFF by default. Enable only after reviewing provider
# terms, free-tier limits, and billing settings.
ENABLE_CLOUD_FALLBACKS=false
CLOUD_MAX_CALLS_PER_DAY=10

# Optional free-tier cloud fallbacks. Not required for local Ollama use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter is accepted only when OPENROUTER_MODEL ends in :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Paid-provider keys are deliberately not used by this free-first runtime.
