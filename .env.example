# Server-side only. Never put real secrets in frontend code or commit this file with values.
# Copy to .env locally; deployment secrets belong in your hosting provider's secret manager.

PORT=3000
APP_BASE_URL=http://localhost:3000

# Configure only on the server after authentication and encrypted vault are implemented.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Generate a cryptographically random 32-byte key and store it in your server's secret manager.
# Do not commit a real value.
VAULT_ENCRYPTION_KEY=
SESSION_SECRET=

# Browser worker should run separately with isolated sessions and strict domain allowlists.
BROWSER_WORKER_URL=
